<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY: cleartext HTTP is allowed so the app can reach a development server on the emulator host or
     the local network (entered in the app's Server settings). Release builds use src/main's HTTPS-only config. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
