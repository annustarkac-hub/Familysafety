# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with:  openssl rand -base64 48

# --- PostgreSQL ---
POSTGRES_DB=familysafety
POSTGRES_USER=familysafety
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend ---
# Base64-encoded, >= 32 bytes after decoding. Signs HS256 access tokens.
JWT_SECRET=
# Base64-encoded, >= 32 bytes. Server-side pepper for hashing pairing codes.
PAIRING_PEPPER=
# Reject non-HTTPS API requests. Keep true outside local emulator development
# (TLS is terminated by the Caddy proxy, which sets X-Forwarded-Proto).
REQUIRE_HTTPS=true
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D
RATE_LIMIT_ENABLED=true

# --- WebRTC ICE ---
STUN_URLS=stun:stun.l.google.com:19302
# Optional TURN (coturn "use-auth-secret"). Leave empty to disable TURN.
TURN_URLS=
TURN_SECRET=

# --- TLS proxy (Caddy) ---
# Public hostname for the API. "localhost" gets a locally-issued dev certificate.
API_HOSTNAME=localhost
